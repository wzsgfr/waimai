<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.DishMapper">
    <delete id="delete">
        DELETE FROM dish <where>
        <foreach collection="ids" item="id" separator="," open="id in (" close=")">
            #{id}
        </foreach>
    </where>
    </delete>
    <select id="page" resultType="com.sky.vo.DishVO">
        SELECT d.*,c.name category_Name from dish d left join category c on d.category_id = c.id
        <where>
            <if test="name!=null and name!=''">
                and d.name like concat('%',#{name},'%')
            </if>
            <if test="categoryId!=null">
                and category_id=#{categoryId}
            </if>
            <if test="status!=null">
                and d.status=#{status}
            </if>
        </where>
        order by update_time desc
    </select>
</mapper>